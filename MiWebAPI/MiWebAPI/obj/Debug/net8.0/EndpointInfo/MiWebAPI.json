  "components": {
    "schemas": {
      "DateOnly": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "month": {
            "type": "integer",
            "format": "int32"
          },
          "day": {
            "type": "integer",
            "format": "int32"
          },
          "dayOfWeek": {
            "$ref": "#/components/schemas/DayOfWeek"
          },
          "dayOfYear": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "dayNumber": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "DayOfWeek": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "type": "integer",
        "format": "int32"
      },
      "Doctor": {
        "required": [
          "apellidos",
          "cedula",
          "correo",
          "especialidad",
          "nombre"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "apellidos": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "especialidad": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "cedula": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "correo": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "telefono": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "aniosExperiencia": {
            "type": "integer",
            "format": "int32"
          },
          "numPacientes": {
            "type": "integer",
            "format": "int32"
          },
          "idiomas": {
            "type": "string",
            "nullable": true
          },
          "precioConsulta": {
            "maximum": 100000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "consultaOnline": {
            "type": "boolean"
          },
          "verificado": {
            "type": "boolean"
          },
          "estadoRegistro": {
            "type": "string",
            "nullable": true
          },
          "ratingPromedio": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "totalResenas": {
            "type": "integer",
            "format": "int32"
          },
          "fotoUrl": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Empleado": {
        "type": "object",
        "properties": {
          "idEmpleado": {
            "type": "integer",
            "format": "int32"
          },
          "nombreCompleto": {
            "type": "string",
            "nullable": true
          },
          "correo": {
            "type": "string",
            "nullable": true
          },
          "sueldo": {
            "type": "number",
            "format": "double"
          },
          "fechaContrato": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "$ref": "#/components/schemas/DateOnly"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
